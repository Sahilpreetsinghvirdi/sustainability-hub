# backend/.env.example
# Copy to .env and fill in your key.

# --- AI Waste Analyzer (required for /api/v1/waste/analyze) ---
AI_PROVIDER=gemini
GEMINI_API_KEY=
# Get a free key at https://aistudio.google.com/apikey
GEMINI_MODEL=gemini-3.6-flash

# Or use OpenAI instead:
# AI_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# --- Database (optional: analyzer works without DB) ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/sustainability
