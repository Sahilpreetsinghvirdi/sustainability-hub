# desktop/.env.example — copy to .env and fill in. Vite picks it up automatically
# (dev server restarts itself when .env changes).

# Google sign-in (popup OAuth, no secret needed):
# 1. Go to https://console.cloud.google.com/apis/credentials
# 2. Create Credentials -> OAuth client ID -> Web application
# 3. Under "Authorized redirect URIs" add EXACTLY:
#      http://localhost:1420/auth/callback
#    (plus your Tauri/production origin later, e.g. https://tauri.localhost/auth/callback)
# 4. Paste the client ID below (ends with .apps.googleusercontent.com)
VITE_GOOGLE_CLIENT_ID=

# Microsoft sign-in (popup OAuth, no secret needed):
# 1. Go to https://portal.azure.com -> Microsoft Entra ID -> App registrations -> New
# 2. Redirect URI type "Single-page application (SPA)":
#      http://localhost:1420/auth/callback
# 3. Paste the "Application (client) ID" below
VITE_MICROSOFT_CLIENT_ID=
